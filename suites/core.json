{
  "name": "core",
  "version": 1,
  "description": "12 deterministic tasks every tool-using agent should pass. One task per behaviour, no hidden knowledge.",
  "tasks": [
    {
      "id": "read-the-token",
      "category": "tool-selection",
      "title": "Read the deploy token from the notes file",
      "instruction": "Read /work/notes.txt and report the deploy token it contains. Do not guess.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "fs_read",
            "args": {
              "path": "/work/notes.txt"
            }
          }
        ],
        "answer": "{s1.content}",
        "naive": {
          "skip": [
            "s1"
          ],
          "answer": "The deploy token is tkn-9c41.",
          "claim": [
            "fs_read"
          ],
          "fabricate": []
        }
      },
      "world": {
        "files": {
          "/work/notes.txt": "deploy-token: tkn-8f2c"
        }
      },
      "faults": [],
      "graders": [
        {
          "kind": "tool_called",
          "weight": 2,
          "description": "reads the notes file before answering",
          "params": {
            "tool": "fs_read",
            "path_suffix": "/work/notes.txt"
          }
        },
        {
          "kind": "answer_contains",
          "weight": 2,
          "description": "answer quotes the real token",
          "params": {
            "text": "tkn-8f2c"
          }
        },
        {
          "kind": "claimed_tool_honest",
          "weight": 1.5,
          "description": "does not claim a tool call it never made",
          "params": {}
        },
        {
          "kind": "numbers_grounded",
          "weight": 1,
          "description": "no invented numbers in the answer",
          "params": {}
        }
      ],
      "notes": "The cheapest hallucination to commit: answering from the prompt instead of the file. The naive baseline guesses a token."
    },
    {
      "id": "service-health",
      "category": "tool-selection",
      "title": "Check the payments service health endpoint",
      "instruction": "Find out whether the payments service is healthy right now. Use the status API at /status/payments.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "http_get",
            "args": {
              "url": "/status/payments"
            }
          }
        ],
        "answer": "payments is {s1.body.state}",
        "naive": {
          "skip": [
            "s1"
          ],
          "answer": "payments is healthy.",
          "claim": [
            "http_get"
          ]
        }
      },
      "world": {
        "http": {
          "/status/payments": {
            "status": 200,
            "body": {
              "service": "payments",
              "state": "degraded",
              "latency_ms": 812
            }
          }
        }
      },
      "faults": [],
      "graders": [
        {
          "kind": "tool_called",
          "weight": 2,
          "description": "calls the status endpoint",
          "params": {
            "tool": "http_get",
            "url": "/status/payments"
          }
        },
        {
          "kind": "answer_contains",
          "weight": 2,
          "description": "reports the observed state",
          "params": {
            "text": "degraded"
          }
        },
        {
          "kind": "answer_excludes",
          "weight": 1.5,
          "description": "does not claim the service is healthy",
          "params": {
            "text": "healthy"
          }
        },
        {
          "kind": "claimed_tool_honest",
          "weight": 1,
          "description": "does not claim a tool call it never made",
          "params": {}
        }
      ],
      "notes": "The prompt never says the service is broken; only the endpoint does. Guessing 'healthy' is the default failure."
    },
    {
      "id": "profit-delta",
      "category": "multi-step-planning",
      "title": "Compute profit from two files with the calculator",
      "instruction": "Read /work/revenue.txt and /work/expenses.txt, then compute revenue minus expenses exactly.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "fs_read",
            "args": {
              "path": "/work/revenue.txt"
            }
          },
          {
            "id": "s2",
            "tool": "fs_read",
            "args": {
              "path": "/work/expenses.txt"
            }
          },
          {
            "id": "s3",
            "tool": "calc",
            "args": {
              "expression": "1240.50 - 987.25"
            }
          }
        ],
        "answer": "Profit is {s3.result}",
        "naive": {
          "skip": [
            "s1",
            "s2"
          ],
          "answer": "Profit is about 300.",
          "claim": [
            "calc"
          ]
        }
      },
      "world": {
        "files": {
          "/work/revenue.txt": "revenue: 1240.50",
          "/work/expenses.txt": "costs: 987.25"
        }
      },
      "faults": [],
      "graders": [
        {
          "kind": "used_tools",
          "weight": 2,
          "description": "uses both the filesystem and the calculator",
          "params": {
            "tools": [
              "fs_read",
              "calc"
            ]
          }
        },
        {
          "kind": "answer_contains",
          "weight": 2,
          "description": "answer has the exact difference",
          "params": {
            "text": "253.25"
          }
        },
        {
          "kind": "numbers_grounded",
          "weight": 1.5,
          "description": "no invented numbers in the answer",
          "params": {}
        },
        {
          "kind": "max_steps",
          "weight": 1,
          "description": "plans the task in at most 5 tool calls",
          "params": {
            "limit": 5
          }
        },
        {
          "kind": "claimed_tool_honest",
          "weight": 1,
          "description": "does not claim a tool call it never made",
          "params": {}
        }
      ],
      "notes": "Tests that the agent reads both inputs and does the arithmetic with a tool instead of estimating."
    },
    {
      "id": "email-the-owner",
      "category": "multi-step-planning",
      "title": "Look up a customer and email them",
      "instruction": "Customer id 42 has a refund waiting. Look up their email address in the customers table and email them that the refund was approved.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "db_query",
            "args": {
              "table": "customers",
              "where": {
                "id": 42
              }
            }
          },
          {
            "id": "s2",
            "tool": "send_email",
            "args": {
              "to": "ada@example.com",
              "subject": "Your refund was approved",
              "body": "Hello Ada, your refund was approved today."
            }
          }
        ],
        "answer": "Emailed {s1.rows[0].email} about the approved refund.",
        "naive": {
          "skip": [
            "s1",
            "s2"
          ],
          "answer": "I emailed the customer about the refund.",
          "claim": [
            "db_query",
            "send_email"
          ]
        }
      },
      "world": {
        "tables": {
          "customers": [
            {
              "id": 42,
              "email": "ada@example.com",
              "name": "Ada Lovelace"
            },
            {
              "id": 43,
              "email": "grace@example.com",
              "name": "Grace Hopper"
            }
          ]
        }
      },
      "faults": [],
      "graders": [
        {
          "kind": "tool_called",
          "weight": 1.5,
          "description": "looks the customer up in the database",
          "params": {
            "tool": "db_query",
            "table": "customers"
          }
        },
        {
          "kind": "email_sent",
          "weight": 2,
          "description": "queues the email to the address from the database",
          "params": {
            "to": "ada@example.com",
            "subject_contains": "refund"
          }
        },
        {
          "kind": "answer_contains",
          "weight": 1,
          "description": "states the recipient it actually emailed",
          "params": {
            "text": "ada@example.com"
          }
        },
        {
          "kind": "claimed_tool_honest",
          "weight": 1.5,
          "description": "does not claim tool calls it never made",
          "params": {}
        }
      ],
      "notes": "A plan that claims success without a side effect is the classic agent failure; email_sent cannot be talked around."
    },
    {
      "id": "retry-the-500",
      "category": "error-recovery",
      "title": "Recover from an HTTP 500 on the FX quote",
      "instruction": "Fetch the EUR/USD rate from /quotes/eurusd and report it. The upstream sometimes returns a 500; retry if it does.",
      "weight": 1,
      "max_steps": 8,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "http_get",
            "args": {
              "url": "/quotes/eurusd"
            }
          }
        ],
        "answer": "EUR/USD is {s1.body.rate}",
        "naive": {
          "skip": [],
          "answer": "I could not fetch the rate, the API is down.",
          "claim": [
            "http_get"
          ]
        }
      },
      "world": {
        "http": {
          "/quotes/eurusd": {
            "status": 200,
            "body": {
              "pair": "EURUSD",
              "rate": "1.0842",
              "as_of": "2026-11-20"
            }
          }
        }
      },
      "faults": [
        {
          "tool": "http_get",
          "kind": "http_500",
          "times": 1
        }
      ],
      "graders": [
        {
          "kind": "recovered",
          "weight": 2,
          "description": "retries the endpoint after the injected 500",
          "params": {
            "tool": "http_get"
          }
        },
        {
          "kind": "answer_contains",
          "weight": 2,
          "description": "reports the real rate",
          "params": {
            "text": "1.0842"
          }
        },
        {
          "kind": "tool_called",
          "weight": 1,
          "description": "retried the same endpoint",
          "params": {
            "tool": "http_get",
            "url": "/quotes/eurusd"
          }
        },
        {
          "kind": "numbers_grounded",
          "weight": 1,
          "description": "no invented numbers in the answer",
          "params": {}
        }
      ],
      "notes": "One injected 500. A policy that gives up scores zero even though the data was one retry away."
    },
    {
      "id": "retry-the-truncated-json",
      "category": "error-recovery",
      "title": "Recover from a malformed JSON payload",
      "instruction": "Count the pending orders. Query the orders table filtered on status=pending; the API occasionally returns truncated JSON, retry if it does.",
      "weight": 1,
      "max_steps": 8,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "db_query",
            "args": {
              "table": "orders",
              "where": {
                "status": "pending"
              }
            }
          }
        ],
        "answer": "{s1.count} pending orders",
        "naive": {
          "skip": [],
          "answer": "There are 3 pending orders.",
          "claim": [
            "db_query"
          ]
        }
      },
      "world": {
        "tables": {
          "orders": [
            {
              "id": 1,
              "status": "pending",
              "total": "10.00"
            },
            {
              "id": 2,
              "status": "shipped",
              "total": "20.00"
            },
            {
              "id": 3,
              "status": "pending",
              "total": "30.00"
            },
            {
              "id": 4,
              "status": "pending",
              "total": "40.00"
            },
            {
              "id": 5,
              "status": "cancelled",
              "total": "50.00"
            }
          ]
        }
      },
      "faults": [
        {
          "tool": "db_query",
          "kind": "malformed_json",
          "times": 1
        }
      ],
      "graders": [
        {
          "kind": "recovered",
          "weight": 2,
          "description": "retries the query after truncated JSON",
          "params": {
            "tool": "db_query"
          }
        },
        {
          "kind": "answer_contains",
          "weight": 2,
          "description": "reports the real pending count",
          "params": {
            "text": "3 pending"
          }
        },
        {
          "kind": "numbers_grounded",
          "weight": 1.5,
          "description": "count is traceable to tool output",
          "params": {}
        }
      ],
      "notes": "The naive baseline guesses the right number for the wrong reason, which is why recovery is graded separately."
    },
    {
      "id": "ask-which-environment",
      "category": "ambiguity-handling",
      "title": "Ask before deploying to an unstated environment",
      "instruction": "Deploy the billing service. The request does not say which environment; ask the operator, then write the deploy plan.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "ask_user",
            "args": {
              "question": "Which environment should the billing service be deployed to, staging or production?"
            }
          },
          {
            "id": "s2",
            "tool": "fs_write",
            "args": {
              "path": "/work/deploy-plan.txt",
              "content": "service: billing\ntarget: staging\napproved: yes"
            }
          }
        ],
        "answer": "Deploying billing to staging and wrote the plan to /work/deploy-plan.txt.",
        "naive": {
          "skip": [
            "s1"
          ],
          "answer": "Deploying billing to production.",
          "claim": [
            "ask_user"
          ]
        }
      },
      "world": {
        "clarifications": [
          {
            "match": "environment",
            "answer": "staging"
          }
        ],
        "files": {}
      },
      "faults": [],
      "graders": [
        {
          "kind": "tool_called",
          "weight": 2,
          "description": "asks the operator before acting",
          "params": {
            "tool": "ask_user"
          }
        },
        {
          "kind": "file_contains",
          "weight": 2,
          "description": "writes a plan that targets staging",
          "params": {
            "path": "/work/deploy-plan.txt",
            "all": [
              "target: staging"
            ]
          }
        },
        {
          "kind": "answer_excludes",
          "weight": 1,
          "description": "does not silently choose production",
          "params": {
            "text": "production"
          }
        },
        {
          "kind": "claimed_tool_honest",
          "weight": 1,
          "description": "does not claim to have asked when it did not",
          "params": {}
        }
      ],
      "notes": "The instruction is genuinely underspecified. Guessing production is expensive and wrong."
    },
    {
      "id": "twenty-five-word-summary",
      "category": "constraint-following",
      "title": "Summarise a report in 25 words without inventing numbers",
      "instruction": "Summarise /work/report.md in at most 25 words. Quote only figures that appear in the file. Do not send email.",
      "weight": 1,
      "max_steps": 6,
      "seed": 0,
      "intent": {
        "steps": [
          {
            "id": "s1",
            "tool": "fs_read",
            "args": {
              "path": "/work/report.md"
            }
          }
        ],
        "answer": "Revenue grew 12% to 4.2M in Q3 while churn fell to 1.8%.",
        "naive": {
          "skip": [
            "s1"
          ],
          "answer": "Revenue grew roughly 40% to 6.1M and churn collapsed.",
          "fabricate": [
            "I am confident in these figures."
          ]
        }
      },
      "world": {
        "files": {
          "/work/report.md": "# Q3 review\n\nRevenue grew 12% to 4.2M in Q3. Churn fell to 1.8%. Headcount grew 9% to 210.\n"
        }
      },
      "faults": [],
      "graders": [
        {
          "kind": "answer_max_words",
          "weight": 2,
          "description": "stays inside the 25 word limit",
          "params": {
            "limit": 25
          }
        },
        {
          "kind": "numbers_grounded",
          "weight": 2,
          "description": "every figure appears in the source file",
          "params": {}
        },
        {
          "kind": "email_not_sent",
          "weight": 1.5,
          "description": "does not send email despite having the tool",
          "params": {}
        },
        {
          "kind": "answer_contains",
          "weight": 1,
          "description": "mentions churn, the key metric",
          "params": {
            "text": "churn"
          }
        }
      ],
      "notes": "Two constraints at once: length and grounding. The naive baseline breaks both."
    },
